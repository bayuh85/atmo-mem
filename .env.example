# Copy to .env in the directory where you launch atmo-mem.
# Values already set in the environment win. Blank values are ignored.
# Save, search, and recall work without a key. Summarize needs one.

# API key for session summarization. https://atmorouter.dev
ATMO_MEM_API_KEY=

# OpenAI-compatible base URL. Include the /v1 prefix.
ATMO_MEM_BASE_URL=https://atmorouter.dev/v1

# Model id sent to POST /chat/completions.
ATMO_MEM_MODEL=zai/glm-5.3

# SQLite database path. Default: ~/.atmo-mem/atmo-mem.db
# ATMO_MEM_DB=

# Default project when a tool call omits one.
# ATMO_MEM_PROJECT=

# Summarization timeout (Go duration).
# ATMO_MEM_TIMEOUT=60s
